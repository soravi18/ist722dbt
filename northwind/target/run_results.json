elect * from analytics.dbt_sravi_northwind.dim_employee\n),\nd_date as (\n    select * from analytics.dbt_sravi_northwind.dim_date\n),\nd_product as (\n    select * from analytics.dbt_sravi_northwind.dim_product\n)\n\nselect \n    d_customer.*,\n    d_employee.*,\n    d_date.*,\n    d_product.*,\n    f.orderkey,\n    f.quantity,\n    f.extendedpriceamount,\n    f.discountamount,\n    f.soldamount\n    from f_sales as f\n        left join d_customer on f.customerkey = d_customer.customerkey\n        left join d_employee on f.employeekey = d_employee.employeekey\n        left join d_date on f.orderdatekey = d_date.datekey\n        left join d_product on f.productkey = d_product.productkey", "relation_name": "analytics.dbt_sravi_northwind.obt_sales"}, {"status": "success", "timing": [{"name": "compile", "started_at": "2024-03-28T22:34:59.257496Z", "completed_at": "2024-03-28T22:34:59.272052Z"}, {"name": "execute", "started_at": "2024-03-28T22:34:59.272950Z", "completed_at": "2024-03-28T22:34:59.853653Z"}], "thread_id": "Thread-9 (worker)", "execution_time": 0.636134147644043, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01b34c8a-0000-1bcb-000b-3d830001202e"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.northwind.obt_order_fulfillment", "compiled": true, "compiled_code": "with f_order_fulfillment as (\n    select * from analytics.dbt_sravi_northwind.fact_order_fulfillment\n),\nd_customer as (\n    select * from analytics.dbt_sravi_northwind.dim_customer\n),\nd_employee as (\n    select * from analytics.dbt_sravi_northwind.dim_employee\n),\nd_date as (\n    select * from analytics.dbt_sravi_northwind.dim_date\n)\nselect \n    d_customer.*, \n    d_employee.*, \n    d_date.*,\n    f.orderid, f.orderdatekey, f.shippeddatekey, f.requireddatekey, f.shipname, f.shipaddress, f.shipcity, f.shipregion, f.shippostalcode, f.shipcountry,\n    f.freight, f.shipvia, f.shippercompanyname, f.quantityonorder, f.totalorderamount, f.daysfromordertoshipped, f.daysfromordertorequired, f.shippedtorequireddelta, f.shippedontime\n    from f_order_fulfillment as f\n    left join d_customer on f.customerkey = d_customer.customerkey\n    left join d_employee on f.employeekey = d_employee.employeekey\n    left join d_date on f.orderdatekey = d_date.datekey", "relation_name": "analytics.dbt_sravi_northwind.obt_order_fulfillment"}], "elapsed_time": 6.458123445510864, "args": {"partial_parse": true, "log_format": "json", "static_parser": true, "log_format_file": "json", "warn_error_options": {"include": [], "exclude": []}, "log_level": "info", "populate_cache": true, "vars": {}, "log_file_max_bytes": 0, "include_saved_query": false, "which": "build", "source_freshness_run_project_hooks": false, "enable_legacy_logger": false, "macro_debugging": false, "resource_types": [], "strict_mode": false, "indirect_selection": "eager", "use_colors": true, "version_check": true, "show_resource_report": false, "invocation_command": "dbt -A dbt_worker.app worker --loglevel=DEBUG --concurrency=2 --max-memory-per-child=500000", "export_saved_queries": false, "write_json": true, "project_dir": "/usr/src/develop/user-270879/environment-297921/repository-212869/northwind", "exclude_resource_types": [], "exclude": [], "use_colors_file": true, "profiles_dir": "/usr/src/dbt-server-shared/.dbt", "send_anonymous_usage_stats": true, "partial_parse_file_diff": true, "defer": false, "log_level_file": "debug", "printer_width": 80, "print": true, "cache_selected_only": false, "select": [], "profile": "user", "quiet": false, "introspect": true, "show": false, "favor_state": false, "log_path": "/usr/src/dbt-server-shared/working_dir/02bb541e-06af-44d6-91c8-394123d5ceff"}}